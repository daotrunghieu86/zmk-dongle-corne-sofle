#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define SYS 3
#define MOUSE 4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys_layer {
            if-layers = <NAV SYM>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";

            // ------------------------------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |MISSION |  | CLOSE |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | OPT | CMD  | NAV  | ENTER|  BSPC  |  | DEL   | SPACE| SYM   | CMD   | OPT  |

            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                            &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS
&kp ESC    &kp Q   &kp W     &kp E     &kp R      &kp T                             &kp Y   &kp U      &kp I      &kp O     &kp P     &kp BSPC
&kp TAB    &kp A   &kp S     &kp D     &kp F      &kp G                             &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V      &kp B   &kp LC(UP)    &kp LG(W)  &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp LALT  &kp LGUI  &mo NAV    &kp RET   &kp BSPC     &kp DEL     &kp SPACE &mo SYM &kp RGUI   &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT) &inc_dec_kp LG(LS(RBKT)) LG(LS(LBKT))>;
        };

        nav_layer {
            display-name = "NAV";

            // ------------------------------------------------------------------------------------------------------------
            // Browser, editor, word, line and tab navigation for macOS.

            bindings = <
&trans  &trans        &trans        &trans           &trans           &trans                         &trans        &trans      &trans       &trans        &trans         &trans
&trans  &kp LG(LBKT)  &kp LG(RBKT)  &trans           &trans           &trans                         &kp HOME      &kp LA(LEFT) &kp LA(RIGHT) &kp END      &kp RET         &trans
&trans  &kp LALT      &kp LCTRL     &kp LSHFT        &kp LGUI        &kp TAB                        &kp LEFT      &kp DOWN     &kp UP       &kp RIGHT    &kp DEL         &kp BSPC
&trans  &kp PG_DN     &kp PG_UP     &kp LG(LS(LBKT)) &kp LG(LS(RBKT)) &trans      &trans    &trans  &trans        &trans      &trans       &trans        &kp LG(W)       &trans
                      &trans        &trans           &trans           &trans      &trans    &trans  &trans        &trans      &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT) &inc_dec_kp LG(LS(RBKT)) LG(LS(LBKT))>;
        };

        sym_layer {
            display-name = "SYM";

            // ------------------------------------------------------------------------------------------------------------
            // Numbers, brackets and programming symbols.

            bindings = <
&kp GRAVE  &kp N1     &kp N2    &kp N3       &kp N4    &kp N5                         &kp N6     &kp N7    &kp N8           &kp N9     &kp N0     &kp MINUS
&kp TILDE  &kp EXCL   &kp AT    &kp HASH     &kp DLLR  &kp PRCNT                      &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR   &kp RPAR   &kp UNDER
&trans     &kp LBRC   &kp RBRC  &kp LPAR     &kp RPAR  &kp LT                         &kp GT     &kp LBKT  &kp RBKT          &kp SEMI   &kp COLON  &kp SQT
&trans     &kp EQUAL  &kp MINUS &kp KP_PLUS  &kp BSLH  &kp PIPE     &trans    &trans  &kp FSLH   &kp COMMA &kp DOT           &kp QMARK  &trans     &trans
                    &trans     &trans       &trans     &trans     &trans     &trans  &trans      &trans    &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT) &inc_dec_kp LG(LS(RBKT)) LG(LS(LBKT))>;
        };

        sys_layer {
            display-name = "SYS";

            // Hold NAV + SYM together for function keys, Bluetooth, media and mouse toggle.
            bindings = <
&trans      &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                           &kp F6        &kp F7        &kp F8      &kp F9      &kp F10     &kp F11
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &kp C_BRI_DN  &kp C_BRI_UP  &kp C_PREV  &kp C_PP    &kp C_NEXT  &kp F12
&trans      &trans        &trans        &trans        &trans        &kp CLCK                        &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &trans      &trans      &trans
&sys_reset  &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans        &tog MOUSE   &trans      &trans      &trans      &sys_reset
                          &trans        &trans        &trans        &trans        &trans    &trans  &trans        &trans        &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT) &inc_dec_kp LG(LS(RBKT)) LG(LS(LBKT))>;
        };

        mouse_layer {
            display-name = "MOUSE";

            // Toggle from SYS with physical M. Exit with Esc or M.
            bindings = <
&trans      &trans        &trans          &trans         &trans          &trans                         &trans          &trans          &trans       &trans       &trans       &trans
&tog MOUSE  &mkp MB4      &mmv MOVE_UP    &mkp MB5       &trans          &trans                         &trans          &trans          &trans       &trans       &trans       &trans
&trans      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &mkp LCLK      &mkp RCLK                      &msc SCRL_UP    &msc SCRL_DOWN  &mkp MCLK   &trans       &trans       &trans
&trans      &trans        &trans          &trans         &trans          &trans       &trans    &trans  &trans          &tog MOUSE     &trans       &trans       &trans       &trans
                          &trans          &trans         &trans          &trans       &trans    &trans  &trans          &trans         &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT) &inc_dec_kp LG(LS(RBKT)) LG(LS(LBKT))>;
        };
    };
};
